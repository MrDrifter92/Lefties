<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Felix & Frank</title>
  <meta name="description" content="Felix & Frank — streetwear built on recovery, not perfection." />
  <style>
    :root{
      --bg:#0f1110;           /* deep charcoal */
      --card:#171a18;         /* dark olive */
      --primary:#77c36b;      /* gumtree green */
      --accent:#b8905d;       /* warm sand */
      --ink:#e8f6e5;          /* eucalyptus milk */
      --muted:#9fb29a;        /* soft sage */
      --danger:#ff6b6b;
      --shadow:0 10px 30px rgba(0,0,0,.35);
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
      color:var(--ink);
      background:radial-gradient(1200px 600px at 10% -10%, rgba(119,195,107,.15), transparent 60%),
                 radial-gradient(1200px 600px at 110% 10%, rgba(184,144,93,.12), transparent 60%),
                 var(--bg);
    }
    a{color:var(--primary);text-decoration:none}
    .wrap{max-width:1100px;margin:0 auto;padding:32px}
    header{
      display:flex;gap:20px;align-items:center;justify-content:space-between;margin-bottom:24px
    }
    .brand{display:flex;gap:16px;align-items:center}
    .logo{
      width:60px;height:60px;display:grid;place-items:center;background:linear-gradient(145deg, #1b201c, #0e0f0e);
      border:1px solid #212522;border-radius:16px;box-shadow:var(--shadow)
    }
    .wordmark{line-height:1}
    .title{margin:0;font-weight:800;font-size: clamp(28px, 3.8vw, 44px);letter-spacing:.5px}
    .subtitle{margin:2px 0 0;color:var(--muted);font-size:14px}
    .cta{display:flex;gap:12px;flex-wrap:wrap}
    .btn{
      display:inline-flex;align-items:center;gap:10px;border:1px solid #263026;
      background:linear-gradient(180deg, rgba(119,195,107,.18), rgba(119,195,107,.08));
      color:var(--ink);padding:12px 16px;border-radius:14px;box-shadow:var(--shadow);
      transition:.2s transform ease, .2s background ease, .2s border-color ease
    }
    .btn:hover{transform:translateY(-1px);border-color:var(--primary)}
    .btn.alt{background:linear-gradient(180deg, rgba(184,144,93,.18), rgba(184,144,93,.08))}
    .card{background:linear-gradient(180deg, rgba(255,255,255,.02), rgba(255,255,255,.00));
      border:1px solid #212522;border-radius:22px;padding:22px;box-shadow:var(--shadow)}
    .grid{display:grid;grid-template-columns:1.1fr .9fr;gap:22px}
    @media (max-width: 900px){.grid{grid-template-columns:1fr}}

    /* Fancy mirrored F logo */
    .ff{font-weight:900;font-size:28px;letter-spacing:1px;display:flex;gap:6px;align-items:center}
    .f{display:inline-block;transform:scaleX(-1);}

    /* Diamond badge */
    .diamond{width:22px;height:22px;vertical-align:-2px;}

    /* Game */
    .game{background: #0a0c0b;border-radius:18px;border:1px solid #202320;display:grid;grid-template-rows:auto 1fr auto;min-height:420px;overflow:hidden}
    .gamebar{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-bottom:1px solid #212522;background:linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,0))}
    .score{font-weight:700}
    .canvas-wrap{position:relative}
    canvas{display:block;width:100%;height:380px;background:radial-gradient(800px 300px at 70% -100px, rgba(119,195,107,.10), transparent 60%), #0a0c0b}
    .controls{display:flex;gap:8px;justify-content:center;padding:12px;border-top:1px solid #212522}
    .control{padding:10px 14px;border-radius:12px;border:1px solid #2b322b;background:#131614;color:var(--ink)}
    .control:active{transform:scale(.98)}

    footer{opacity:.9;color:var(--muted);font-size:13px;margin-top:30px}
    .chip{display:inline-flex;gap:8px;align-items:center;padding:8px 12px;border:1px solid #263026;border-radius:999px;background:#141814}

    .badge{display:inline-flex;align-items:center;gap:8px;padding:10px 12px;border:1px solid #2b322b;border-radius:12px}
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <div class="brand">
        <div class="logo" aria-hidden="true">
          <!-- Inline SVG diamond -->
          <svg class="diamond" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <path d="M12 24 L24 8 L40 8 L52 24 L32 56 Z" stroke="url(#g1)" stroke-width="3" fill="url(#g2)"/>
            <path d="M24 8 L32 24 L40 8" stroke="url(#g1)" stroke-width="3"/>
            <defs>
              <linearGradient id="g1" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#77c36b"/>
                <stop offset="1" stop-color="#b8905d"/>
              </linearGradient>
              <linearGradient id="g2" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="rgba(119,195,107,.25)"/>
                <stop offset="1" stop-color="rgba(184,144,93,.18)"/>
              </linearGradient>
            </defs>
          </svg>
        </div>
        <div class="wordmark">
          <h1 class="title">Felix <span style="opacity:.65">&</span> Frank</h1>
          <p class="subtitle">Streetwear built on recovery, not perfection.</p>
        </div>
      </div>
      <div class="cta">
        <!-- EDIT THIS URL to your real site or socials -->
        <a class="btn" href="https://felixandfrank.example" target="_blank" rel="noopener">Visit Store</a>
        <a class="btn alt" href="#game">Play mini‑game</a>
      </div>
    </header>

    <div class="grid">
      <section class="card">
        <div class="badge" title="Mirrored double-F">
          <span class="ff"><span class="f">F</span>F</span>
          <span style="color:var(--muted)"> two sides, same bloke</span>
        </div>
        <h2 style="margin:14px 0 8px">Wear your split side with pride</h2>
        <p style="color:var(--muted);margin-top:0">Felix is calm and grounded. Frank’s the chaos and the scars. Both honest. We build threads that can carry both — earthy, tough and clean as.
        </p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:12px">
          <span class="chip">100% street</span>
          <span class="chip">Aussie‑born</span>
          <span class="chip">Sage & sand palette</span>
        </div>
      </section>

      <section id="game" class="card game" aria-label="Diamond Dash mini game">
        <div class="gamebar">
          <strong>Diamond Dash</strong>
          <div>
            <span class="score" id="score">0</span>
            <button id="start" class="control" aria-label="Start game">Start</button>
          </div>
        </div>
        <div class="canvas-wrap">
          <canvas id="c" width="800" height="380" aria-label="Game canvas"></canvas>
        </div>
        <div class="controls" aria-label="Mobile controls">
          <button class="control" data-x="-1">◀︎</button>
          <button class="control" data-x="1">▶︎</button>
        </div>
      </section>
    </div>

    <footer>
      <p>© <span id="year"></span> Felix & Frank. Built with grit and a bit of cheek.
        · <a href="https://felixandfrank.example" target="_blank" rel="noopener">felixandfrank.example</a>
      </p>
    </footer>
  </div>

<script>
  // ---------- helpers
  const clamp=(n,min,max)=>Math.max(min,Math.min(max,n));
  const lerp=(a,b,t)=>a+(b-a)*t;

  // ---------- logo sparkle easter‑egg (hover)
  (()=>{
    const logo=document.querySelector('.logo');
    logo.addEventListener('pointermove',e=>{
      const r=logo.getBoundingClientRect();
      const x=(e.clientX-r.left)/r.width; const y=(e.clientY-r.top)/r.height;
      logo.style.boxShadow=`0 10px 30px rgba(0,0,0,.35), 0 0 20px rgba(119,195,107,${.2+0.25*(1-y)})`;
      logo.style.transform=`translateY(${lerp(0,-1,y)}px)`
    });
    logo.addEventListener('pointerleave',()=>{
      logo.style.boxShadow='var(--shadow)';logo.style.transform='none'
    });
  })();

  // ---------- game
  const canvas=document.getElementById('c');
  const ctx=canvas.getContext('2d');
  const startBtn=document.getElementById('start');
  const scoreEl=document.getElementById('score');
  const yearEl=document.getElementById('year'); yearEl.textContent=new Date().getFullYear();

  let W,H; const resize=()=>{W=canvas.clientWidth;H=canvas.clientHeight;canvas.width=W;canvas.height=H};
  window.addEventListener('resize',resize); resize();

  let player, gems, particles, score, alive, leftHeld=false, rightHeld=false, frankMode=false;

  const reset=()=>{
    player={x:W/2,y:H-26,w:70,h:10,dx:0};
    gems=[]; particles=[]; score=0; alive=true; updateUI();
  };

  const spawnGem=()=>{
    const speed=lerp(2,6,Math.min(1,score/40));
    gems.push({x:Math.random()*W, y:-20, r:10+Math.random()*10, dy:speed});
  };

  const spawnPop=(x,y)=>{
    for(let i=0;i<10;i++) particles.push({x,y,dx:(Math.random()-.5)*3,dy:(Math.random()-.5)*3,life:40});
  };

  const drawDiamond=(x,y,scale=1)=>{
    const r=10*scale;
    ctx.save();
    ctx.translate(x,y);
    ctx.beginPath();
    ctx.moveTo(0,-r);
    ctx.lineTo(r*1.1,0);
    ctx.lineTo(0,r*1.2);
    ctx.lineTo(-r*1.1,0);
    ctx.closePath();
    const grad=ctx.createLinearGradient(-r,-r,r,r);
    grad.addColorStop(0,'rgba(119,195,107,.9)');
    grad.addColorStop(1,'rgba(184,144,93,.9)');
    ctx.fillStyle=grad; ctx.strokeStyle='rgba(255,255,255,.25)'; ctx.lineWidth=2;
    ctx.fill(); ctx.stroke();
    ctx.restore();
  };

  function updateUI(){ scoreEl.textContent=score; }

  function tick(){
    if(!alive) return;
    ctx.clearRect(0,0,W,H);

    // background grid
    ctx.globalAlpha=.06; ctx.strokeStyle='#9fb29a';
    for(let x=0;x<W;x+=40){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();}
    for(let y=0;y<H;y+=40){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}
    ctx.globalAlpha=1;

    // player
    player.dx = (rightHeld?5:0) - (leftHeld?5:0);
    player.x = clamp(player.x + player.dx, player.w/2, W - player.w/2);
    ctx.fillStyle = frankMode? 'rgba(255,107,107,.9)':'rgba(232,246,229,.95)';
    ctx.fillRect(player.x - player.w/2, player.y - player.h/2, player.w, player.h);

    // gems
    if(Math.random()<.04) spawnGem();
    for(let i=gems.length-1;i>=0;i--){
      const g=gems[i]; g.y+=g.dy;
      drawDiamond(g.x,g.y,g.r/10);
      // catch
      if(g.y+g.r>player.y-6 && Math.abs(g.x - player.x) < (player.w/2+g.r*.7)){
        score++; updateUI(); spawnPop(g.x,g.y); gems.splice(i,1); continue;
      }
      // missed
      if(g.y - g.r > H){ alive=false; gameOver(); break; }
    }

    // particles
    for(let i=particles.length-1;i>=0;i--){
      const p=particles[i]; p.x+=p.dx; p.y+=p.dy; p.life--; ctx.globalAlpha=p.life/40;
      drawDiamond(p.x,p.y,.4); ctx.globalAlpha=1; if(p.life<=0) particles.splice(i,1);
    }

    if(alive) requestAnimationFrame(tick);
  }

  function gameOver(){
    ctx.save(); ctx.fillStyle='rgba(0,0,0,.6)'; ctx.fillRect(0,0,W,H);
    ctx.fillStyle= frankMode ? 'var(--danger)' : 'var(--ink)';
    ctx.font='700 28px ui-sans-serif, system-ui';
    ctx.textAlign='center';
    ctx.fillText('Game over — score '+score, W/2, H/2 - 10);
    ctx.font='400 14px ui-sans-serif, system-ui';
    ctx.fillText('Press Start to try again', W/2, H/2 + 18);
    ctx.restore();
  }

  // input
  window.addEventListener('keydown',e=>{ if(e.key==='ArrowLeft') leftHeld=true; if(e.key==='ArrowRight') rightHeld=true; });
  window.addEventListener('keyup',e=>{ if(e.key==='ArrowLeft') leftHeld=false; if(e.key==='ArrowRight') rightHeld=false; });
  document.querySelectorAll('[data-x]').forEach(b=>{
    let t; b.addEventListener('touchstart',()=>{ if(b.dataset.x==='-1') leftHeld=true; else rightHeld=true; });
    b.addEventListener('touchend',()=>{ leftHeld=false; rightHeld=false; });
  });

  startBtn.addEventListener('click',()=>{ reset(); tick(); });

  // Konami toggles Frank Mode (colour + speed)
  const keys=[]; const KONAMI=['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
  window.addEventListener('keydown',e=>{
    keys.push(e.key); if(keys.length>10) keys.shift();
    if(KONAMI.every((k,i)=>keys[i]===k)){
      frankMode=!frankMode; keys.length=0;
      document.body.style.filter = frankMode? 'saturate(1.3) contrast(1.05)' : 'none';
    }
  });

  // first paint
  reset(); gameOver();
</script>
</body>
</html>
